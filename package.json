{
    "name": "@melchi45/rtsp-over-websocket",
    "version": "1.1.5",
    "author": {
        "name": "Youngho Kim",
        "email": "melchi45@gmail.com",
        "url": "https://github.com/melchi45"
    },
    "description": "RTSP-over-WebSocket player and bridge server components",
    "//": "https://docs.npmjs.com/files/package.json#git-urls-as-dependencies",
    "repository": {
        "type": "git",
        "url": "https://github.com/melchi45/rtsp-over-websocket.git"
    },
    "bugs": {
        "url": "https://github.com/melchi45/rtsp-over-websocket/issues"
    },
    "license": "Hanwha Vision Co., Ltd. Software License.",
    "homepage": "http://ctf.ep.hanwha.com/sf/projects/web_mobile_technical_part/",
    "main": "dist/player/rtsp-over-websocket.esm.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/player/rtsp-over-websocket.esm.js"
        },
        "./react": {
            "types": "./dist/types/react/index.d.ts",
            "import": "./dist/react/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/melchi45"
    },
    "dependencies": {
        "crypto-js": "^4.1.1",
        "express": "^4.22.2",
        "file-saver": "^2.0.5",
        "moment-timezone": "^0.5.43",
        "three": "0.84.0",
        "ws": "^8.13.0"
    },
    "devDependencies": {
        "@types/crypto-js": "^4.2.2",
        "@types/express": "^4.17.25",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^22.0.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/three": "0.84.31",
        "@types/ws": "^8.18.1",
        "jsdom": "^25.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^5.7.0",
        "vite": "^6.0.0",
        "vitest": "^3.0.0"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=0.8.0"
    },
    "overrides": {
        "rollup": "npm:@rollup/wasm-node@4.62.3"
    },
    "scripts": {
        "build:player": "cd src/player && tsc -b && vite build && vite build --config vite.react.config.ts && vite build --config vite.react-lib.config.ts && cd ../.. && npm run build:demo",
        "build:demo": "mkdir -p dist && cp src/index.html dist/index.html",
        "build:server": "cd src/server && tsc -b",
        "test:player": "cd src/player && vitest run",
        "test:player:watch": "cd src/player && vitest",
        "start:player": "node scripts/serve-dist.js",
        "start:server": "node scripts/stop-server.js && node scripts/ensure-mediamtx.js && node scripts/ensure-yt-dlp.js && node scripts/ensure-bgutil-pot-provider.js && npm run build:server && node dist/server/index.js",
        "start:server:http": "node scripts/stop-server.js && node scripts/ensure-mediamtx.js && node scripts/ensure-yt-dlp.js && node scripts/ensure-bgutil-pot-provider.js && npm run build:server && node dist/server/index.js --http",
        "start:server:https": "node scripts/stop-server.js && node scripts/ensure-mediamtx.js && node scripts/ensure-yt-dlp.js && node scripts/ensure-bgutil-pot-provider.js && npm run build:server && node dist/server/index.js --https",
        "stop:server": "node scripts/stop-server.js"
    }
}
