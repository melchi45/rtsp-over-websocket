    "scripts": {
        "build:player": "cd src/player && tsc -b && vite build && cd ../.. && npm run build:demo",
        "build:demo": "mkdir -p dist && cp src/index.html dist/index.html",
        "build:server": "cd src/server && tsc -b",
        "test:player": "cd src/player && vitest run",
        "test:player:watch": "cd src/player && vitest",
        "start:player": "node scripts/serve-dist.js",
        "start:server": "npm run build:server && node dist/server/index.js",
        "start:server:http": "npm run build:server && node dist/server/index.js --http",
        "start:server:https": "npm run build:server && node dist/server/index.js --https",
        "stop": "node scripts/stop-server.js"
    },
    "browserify": {
        "transform": [
            [
                "babelify",
                {
                    "presets": [
                        "@babel/preset-env"
                    ],
                    "plugins": [
                        "static-fs"
                    ]
                }
            ]
        ]
    },
    "settings": {
        "prefix": "rtsp-over-websocket",
        "elements": [
            "player"
        ],
        "browsers": "last 1 version"
    },
