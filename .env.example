# Copy this file to .env and edit as needed. .env is loaded automatically —
# by scripts/loadEnv.js for the plain CJS scripts (stop-server.js,
# ensure-mediamtx.js) and by src/server/loadEnv.ts for the compiled server
# itself — no need to `export` anything in your shell first. Real env vars
# already set always take priority over values here.
#
# Uncomment/edit only the lines you actually want to override; every one of
# these already has a working default (see src/server/config.ts and each
# script's own fallback).

# Which protocol(s) `npm run start:server` starts. Without this set (and
# without --http/--https/--both), start:server prompts interactively when
# run in a real terminal — set this to skip that prompt entirely.
# One of: http | https | both
#RTSP_WS_PROTOCOL=both

# REST + ws://.../StreamingServer port
#RTSP_WS_HTTP_PORT=4000
# REST + wss://.../StreamingServer port
#RTSP_WS_HTTPS_PORT=4001

# Self-signed dev TLS cert/key used for HTTPS/WSS (see scripts/serve-dist.js)
#RTSP_WS_TLS_KEY=certs/dev-server.key
#RTSP_WS_TLS_CERT=certs/dev-server.crt

# MediaMTX RTSP port src/server publishes/relays through
#MEDIAMTX_RTSP_PORT=8554
# MediaMTX HTTP API port
#MEDIAMTX_API_PORT=9997
# Explicit mediamtx binary/config path, if not resolvable via PATH or the
# well-known /opt/mediamtx install location (see scripts/ensure-mediamtx.js)
#MEDIAMTX_BIN=/opt/mediamtx/mediamtx
#MEDIAMTX_CONFIG=/opt/mediamtx/mediamtx.yml

# ---------------------------------------------------------------------------
# src/player/network/http/SunapiManager.live.test.ts — manual/local-only
# smoke test against a *real* camera/NVR on your LAN (SUNAPI login +
# attributes.cgi). Skipped by default; setting RUN_LIVE_DEVICE_TEST=1 here
# (or on the command line) opts in. Loaded via this file's own loadEnv.ts
# copy (src/player/network/http/loadEnv.ts) — same "real env vars win over
# .env" rule as everything else here. Never commit real device credentials
# — put them in your own untracked .env, not .env.example.
#
#   npx vitest run SunapiManager.live.test.ts     (from src/player)
#
#RUN_LIVE_DEVICE_TEST=1
#RTSP_LIVE_TEST_HOSTNAME=192.168.0.2
#RTSP_LIVE_TEST_USERNAME=admin
#RTSP_LIVE_TEST_PASSWORD=changeme
# Optional — defaults shown:
#RTSP_LIVE_TEST_PORT=443
#RTSP_LIVE_TEST_PROTOCOL=https
